<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CadenceAppGroup</key>
	<string>group.$(CADENCE_BUNDLE_ID)</string>
	<key>CadenceGoogleIOSClientPrefix</key>
	<string>$(GOOGLE_IOS_CLIENT_PREFIX)</string>
	<key>CadenceSpotifyClientID</key>
	<string>$(SPOTIFY_CLIENT_ID)</string>
	<key>CadenceMicrosoftClientID</key>
	<string>$(MICROSOFT_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Cadence links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cadence-pair</string>
				<string>cadence-companion</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.$(GOOGLE_IOS_CLIENT_PREFIX)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>Microsoft sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<!-- Only standard encryption from the OS (HTTPS, and TLS-PSK via Network.framework to the
	     paired Mac), which is exempt, so App Store Connect stops asking on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
	</array>
	<!-- The grouped-list grey (black in dark mode) of the home screen, so opening the app doesn't
	     flash a different colour first. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_cadence._tcp</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- A background refresh to take down a missed meeting's Live Activity once its time is up. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>cadence.liveactivity.missed-check</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
