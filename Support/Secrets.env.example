# Copy to Support/Secrets.env (git-ignored) to build a Google OAuth "Desktop app" client into Cadence.
# Desktop client secrets are not confidential by Google's design (PKCE protects sign-in), but keep them
# out of git anyway so nobody else's builds use your project's quota.
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-me
